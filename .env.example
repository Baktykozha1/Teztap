PORT=5000
FRONTEND_PORT=3000

DATABASE_URL=
PGSSLMODE=
PGSSL_REJECT_UNAUTHORIZED=true
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-latest
GEMINI_TIMEOUT_MS=15000
MERCORA_DEMO_MODE=false

# Production frontend origin allowlist, comma-separated (for example https://teztap.example)
CORS_ORIGINS=
API_RATE_WINDOW_MS=60000
API_RATE_LIMIT=90

OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_MS=7000
OVERPASS_CACHE_TTL_MS=300000
OVERPASS_REQUEST_GAP_MS=1100
GEO_CACHE_TTL_MS=300000
GEO_REQUEST_GAP_MS=1100
PUBLIC_GEO_DATA_URL=
PUBLIC_GEO_DATA_NAME=
ORGANIZATION_GEO_DATA_URL=
ORGANIZATION_GEO_DATA_NAME=
TWOGIS_API_KEY=
TWOGIS_API_URL=https://catalog.api.2gis.com/3.0/items
TWOGIS_TIMEOUT_MS=9000
TWOGIS_CACHE_TTL_MS=300000
# 2GIS demo keys are limited to 10 per page; requests automatically retry at 10.
# The 5x5 area grid is fully paginated and has no overall result cap when set to 0.
TWOGIS_PAGE_SIZE=50
TWOGIS_MAX_RESULTS=0
TWOGIS_ENABLE_TILING=true
TWOGIS_TILE_GRID_SIZE=5
TWOGIS_REQUEST_GAP_MS=1100

PRICE_MODERATOR_EMAILS=
PRICE_OBSERVATION_DAILY_LIMIT=20

PROPERTY_MODERATOR_EMAILS=
PROPERTY_OWNER_DAILY_LIMIT=20
PROPERTY_SEARCH_RADIUS_KM=5

API_URL=http://localhost:5000

# Copy this file to deploy/.env and fill the production secrets before starting Compose.
POSTGRES_DB=teztap
POSTGRES_USER=teztap
POSTGRES_PASSWORD=
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800
MERCORA_DEMO_MODE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-latest
TWOGIS_API_KEY=
TWOGIS_API_URL=https://catalog.api.2gis.com/3.0/items
TWOGIS_MAX_RESULTS=0
TWOGIS_ENABLE_TILING=true
API_RATE_LIMIT=90
API_RATE_WINDOW_MS=60000
CORS_ORIGINS=
PGSSLMODE=
PGSSL_REJECT_UNAUTHORIZED=true
WEB_PORT=3000

{
  "name": "teztap",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "server": "node index.js",
    "client": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "node index.js",
    "check": "node scripts/verify.js",
    "check:dev": "node scripts/verify-dev.js",
    "test:unit": "node scripts/verify-unit.js",
    "test:access": "node --test scripts/test-access.js",
    "test:areas": "node --test scripts/test-area-finder.js",
    "test:access:ui": "node scripts/test-access-ui.js",
    "lint": "eslint shared services/access.js services/areaFinder.js services/auth.js services/database.js services/ai.js services/ai/analyticsContext.js services/ai/memoryManager.js index.js scripts/*access*.js scripts/test-area-finder.js frontend/app frontend/components frontend/lib",
    "typecheck:access": "tsc --allowJs --checkJs --noEmit --target es2022 --module commonjs --skipLibCheck shared/access.js"
  },
  "dependencies": {
    "@neon/config": "^1.8.0",
    "@neon/env": "^1.4.5",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2"
  }
}
